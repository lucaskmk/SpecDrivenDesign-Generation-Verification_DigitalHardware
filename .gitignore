# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Saida antiga do pipeline da trilha A (removida); fica ignorada para nao versionar sobras locais
outputs/

# GHDL / cocotb
sim_build/
*.vcd
*.ghw
*.o
*.cf
results.xml

# Segredos (OPENROUTER_API_KEY etc.)
.env
.env.*
!.env.example

# Editor / SO
.DS_Store
.idea/
.vscode/

# Relatorios do validador
/entregas/*/report/

# Sessoes do gerador (rvgen): simulacao e build do GHDL sao
# descartaveis; sessao.jsonl, relatorios e resultado.json ficam versionaveis
**/.rvgen/*/sim/
**/.rvgen/*/build/

# Instaladores Quartus baixados manualmente (ver
# docker/quartus-lite/quartus_installers/README.md) — binarios de GB sob licenca Altera,
# nunca versionados
/docker/quartus-lite/quartus_installers/*.run
/docker/quartus-lite/quartus_installers/*.qdz
/docker/quartus-lite/quartus_installers/SHA256SUMS

# Saida da analise Quartus/FPGA (quartus_testing/)
/quartus_output/
/docker/quartus-lite/quartus_smoketest/quartus_output/
/docker/quartus-lite/quartus_smoketest/output_files/
/docker/quartus-lite/quartus_smoketest/db/
/docker/quartus-lite/quartus_smoketest/incremental_db/
/docker/quartus-lite/quartus_smoketest/*.qws
/docker/quartus-lite/quartus_smoketest/*_pin_model_dump.txt
