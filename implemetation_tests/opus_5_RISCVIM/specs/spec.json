{
  "design": "rv32im_sc",
  "status": "approved",
  "source_rubric": "specs/rubrica.md",
  "target_kind": "processor",
  "top_level": "cpu",
  "word_size_bits": 32,
  "requirements": [
    {"id": "FR-01", "type": "functional", "text": "Palavra/registrador de 32 bits, endereco de 32 bits, memoria por byte little-endian, acessos alinhados.", "source_field": "largura_palavra,largura_endereco,enderecamento_por_byte,little_endian,exige_acesso_alinhado"},
    {"id": "FR-02", "type": "functional", "text": "Banco de 32 registradores de 32 bits, x0 fixo em zero, 2 portas de leitura assincronas e 1 de escrita sincrona.", "source_field": "num_registradores,registrador_zero_fixo,portas_leitura_regbank,portas_escrita_regbank"},
    {"id": "FR-03", "type": "functional", "text": "Conjunto base RV32I: 37 instrucoes com semantica da especificacao RISC-V nao privilegiada.", "source_field": "isa_base"},
    {"id": "FR-04", "type": "functional", "text": "Extensao padrao M em hardware dedicado: mul, mulh, mulhsu, mulhu, div, divu, rem, remu.", "source_field": "isa_extensoes,mult_hardware,div_hardware"},
    {"id": "FR-05", "type": "functional", "text": "Datapath monociclo, CPI 1, controle hardwired combinacional, uma instrucao aposentada por borda de clock.", "source_field": "estagios_pipeline,cpi_alvo,multiciclo_microprogramado,forwarding,deteccao_hazard_stall"},
    {"id": "FR-06", "type": "functional", "text": "Harvard sem cache: ROM de instrucoes 4 KB em 0x00000000 (texto + rodata) e RAM de dados 4 KB em 0x00FC8000.", "source_field": "harvard,niveis_cache,scratchpad,boot_rom,tamanho_boot_rom_kb"},
    {"id": "FR-07", "type": "functional", "text": "Acessos de 8/16/32 bits com extensao de sinal e de zero; acesso fora de faixa ou desalinhado le 0xFFFFFFFF e descarta a escrita.", "source_field": "exige_acesso_alinhado,excecoes_precisas"},
    {"id": "FR-08", "type": "functional", "text": "Desvios e jal PC-relativos, jalr como (rs1+imm) & ~1, PC+4 gravado em rd nos jumps, sem delay slot.", "source_field": "modo_pc_relativo,tem_call_link,tem_delay_slot"},
    {"id": "FR-09", "type": "functional", "text": "Reset sincrono ativo em nivel alto: PC volta a 0x00000000 e nenhuma instrucao e aposentada.", "source_field": "reset_sincrono,reset_ativo_baixo"},
    {"id": "FR-10", "type": "functional", "text": "Interface de verificacao padrao: clk, rst, dbg_pc, dbg_instr, dbg_valid e RAM como signal memory em data_ram_inst (filha direta do top-level).", "source_field": "pipeline:FR-17"},
    {"id": "FR-11", "type": "functional", "text": "Semantica de borda da extensao M: divisao por zero e overflow -2^31/-1 conforme a especificacao RISC-V.", "source_field": "div_hardware"},
    {"id": "FR-12", "type": "functional", "text": "Deslocamentos usam apenas os 5 bits menos significativos do operando, em barrel shifter de um ciclo.", "source_field": "barrel_shifter"},
    {"id": "FR-13", "type": "functional", "text": "Imagem de ROM carregada do .rm do programa via rom_image_pkg.vhd gerado, sem edicao manual de fonte.", "source_field": "pipeline:FR-21"},
    {"id": "FR-14", "type": "functional", "text": "Fora de escopo: fence, ecall, ebreak, CSR/Zicsr, atomicos, ponto flutuante, SIMD, interrupcoes, MMU, privilegio. Instrucao nao reconhecida e tratada como nop.", "source_field": "syscall_trap,tem_interrupcoes,mmu,modos_privilegio,ponto_flutuante,simd,instrucoes_atomicas"},
    {"id": "NFR-01", "type": "non_functional", "category": "area", "text": "Caber em 10000 celulas/LUTs: controle hardwired e datapath monociclo evitam registradores de pipeline, microcodigo, hazard e forwarding.", "source_field": "orcamento_area,alvo_fpga"},
    {"id": "NFR-02", "type": "non_functional", "category": "speed", "text": "CPI 1 com alvo de 50 MHz, aceitando o divisor combinacional no caminho critico (trade-off registrado na fase 2).", "source_field": "cpi_alvo,freq_clock_mhz"},
    {"id": "NFR-03", "type": "non_functional", "category": "power", "text": "Um unico dominio de clock, sem clock gating e sem memoria externa, dentro de 500 mW.", "source_field": "dominios_clock,orcamento_potencia_mw"},
    {"id": "NFR-04", "type": "non_functional", "category": "verification", "text": "Verificacao por cocotb sobre GHDL, por bloco e em nivel de programa, sem hardware de teste alem do trio dbg_*.", "source_field": "pipeline:NFR-04"}
  ],
  "memory_map": {
    "instruction_rom": {"base": "0x00000000", "size_bytes": 4096, "words": 1024, "sections": [".text", ".rodata"]},
    "data_ram": {"base": "0x00FC8000", "size_bytes": 4096, "words": 1024},
