# Copie pra .env e preencha com seus valores reais — .env nunca é commitado (ver .gitignore)
OPENROUTER_API_KEY=
SPECHDL_LLM_MODEL=openai/gpt-5.6-luna

# rvgen — gerador de CPUs (specs/plan.md, seção 9). Tudo opcional: vazio = padrão.
# RVGEN_PROVEDOR=ollama             # ollama (local) | openrouter (externo, usa a chave acima)
# RVGEN_MODELO=qwen2.5-coder:14b    # vazio = perfil escolhido pela memória da GPU
# OLLAMA_HOST=127.0.0.1:11434       # vazio = procura em 127.0.0.1 e host.docker.internal
# RVGEN_NUM_CTX=16384               # janela de contexto do Ollama; 32768 com --exemplo
# RVGEN_TIMEOUT=900                 # segundos por chamada ao modelo
# RVGEN_EXECUTOR=auto               # auto | local (GHDL no host) | docker (spechdl-toolchain)
